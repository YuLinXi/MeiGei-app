{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dontlift.local/schemas/exercise-static-provenance-v1.json",
  "title": "静态动作图来源台账 v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "assets"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "assets": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Z0-9_]+$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "exerciseCode",
          "promptPath",
          "tool",
          "model",
          "generatedAt",
          "inputs",
          "humanEdits",
          "sha256",
          "rightsStatus"
        ],
        "properties": {
          "exerciseCode": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
          "promptPath": { "type": "string", "minLength": 1 },
          "tool": { "type": "string", "minLength": 1 },
          "model": { "type": "string", "minLength": 1 },
          "generatedAt": { "type": "string", "format": "date-time" },
          "inputs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "source", "rightsBasis"],
              "properties": {
                "kind": { "enum": ["original-text", "owned-reference", "cleared-reference"] },
                "source": { "type": "string", "minLength": 1 },
                "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                "rightsBasis": { "type": "string", "minLength": 1 }
              }
            }
          },
          "humanEdits": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "rightsStatus": { "enum": ["pending", "approved", "rejected"] },
          "reviewRecord": { "type": "string" }
        }
      }
    }
  }
}
