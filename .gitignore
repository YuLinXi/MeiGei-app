# macOS
.DS_Store

# Xcode 用户态（个人界面状态/断点，不应入库）
**/xcuserdata/
*.xcuserstate

# Node 依赖（scripts/ 下色板生成工具用，体积大且可重建）
**/node_modules/

# Python 缓存（本地脚本运行产物，可重建）
**/__pycache__/
*.pyc

# Codex/导入调研临时产物（可重建，不应入库）
.codex-tmp/

# Xcode 构建产物 / DerivedData（ios-sim-dev.sh 写入 ios/DontLift/build/sim-dd，可重建）
**/build/
**/DerivedData/
tools/muscle-thumbnail-exporter/.build/
.claude/worktrees/

.vscode/*

# 静态动作图本地候选与可重建生成物；已批准母版和正式 JPG 不忽略
art/exercise-static/staging/
art/exercise-static/candidates/
art/exercise-static/cache/
art/exercise-static/logs/
art/exercise-static/reviews/generated/
art/exercise-static/**/*.tmp
art/exercise-static/**/.env
art/exercise-static/**/.env.*
art/exercise-static/**/*api-key*
art/exercise-static/**/*secret*
